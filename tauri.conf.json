{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autunpad",
  "version": "0.1.0",
  "identifier": "com.autunpad.app",
  "build": {
    "frontendDist": "ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Autunpad",
        "width": 1000,
        "height": 660,
        "minWidth": 680,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "additionalBrowserArgs": "--disable-gpu --disable-gpu-compositing --single-process --disable-site-isolation-trials --disable-features=CalculateNativeWinOcclusion,TranslateUI,msSmartScreenProtection,IsolateOrigins,site-per-process,RendererCodeIntegrity,OptimizationHints,BackForwardCache,IdleDetection,WebOTP,WebUSB,WebRTC,WebGL,WebAudio,MediaRouter --disable-background-networking --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-component-update --disable-extensions --disable-sync --disable-hang-monitor --disable-client-side-phishing-detection --no-first-run --js-flags=\"--max-old-space-size=12\""
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}